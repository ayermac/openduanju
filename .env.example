# Copy to .env, replace values locally. Never commit .env.
MYSQL_ROOT_PASSWORD=replace-with-local-root-password
MYSQL_PASSWORD=replace-with-local-app-password
MYSQL_DATABASE=openduanju_dev
MYSQL_USER=openduanju
# No shared admin token or default password: create the first staff account
# with /app/staff-init after applying migrations.
# Keep development credentials simple alphanumeric to avoid DSN/shell escaping errors.

# Real COS (optional). Keep the real values in the local .env only: they are
# injected into the container through deploy/compose.yaml and never committed.
# Use an isolated bucket with versioning and a least-privilege sub account.
KRATOS_COS_BUCKET=
KRATOS_COS_REGION=
KRATOS_COS_SECRET_ID=
KRATOS_COS_SECRET_KEY=
KRATOS_COS_SESSION_TOKEN=
KRATOS_COS_PREFIX=openduanju-media

# The media resolver: "command" (operator supplied bridge) or "hongguo_sdk"
# (the locked SDK adapter, which builds an anonymous device profile on first
# use and stores it under the profile path).
KRATOS_MEDIA_RESOLVER_DRIVER=command
KRATOS_MEDIA_STORAGE_DRIVER=local
KRATOS_HONGGUO_PROFILE_PATH=/var/lib/openduanju/hongguo/anonymous.json
